# ─── Server Configuration ───────────────────────────────────
PORT=5000

# ─── Database Configuration ─────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/insighto?retryWrites=true&waim=majority

# ─── Authentication ─────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars

# ─── AI Providers (3-Tier Fallback System) ─────────────────
# Option A: Google Gemini (Priority 1)
GOOGLE_API_KEY=your_google_gemini_api_key

# Option B: OpenAI / Groq / SambaNova (Priority 2)
# OpenAI API Key format: sk-proj-...
# Groq API Key format: gsk_... (auto-detected)
# SambaNova API Key format: sbg_... (auto-detected)
OPENAI_API_KEY=your_openai_or_groq_api_key

# Option C: Local Ollama (Priority 3 — automatic offline fallback)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Email & Nodemailer Service ────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token
